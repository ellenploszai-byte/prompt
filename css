:root {
    --bg-color: #f4f7f6;
    --card-bg: #ffffff;
    --text-color: #2c3e50;
    --primary-color: #2563eb;
    --accent-color: #1e40af;
}

[data-theme="dark"] {
    --bg-color: #121212;
    --card-bg: #1e1e1e;
    --text-color: #e0e0e0;
    --primary-color: #3b82f6;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    transition: background-color 0.3s, color 0.3s;
}

body {
    background-color: var(--bg-color);
    color: var(--text-color);
    line-height: 1.6;
}

/* Navbar */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem 5%;
    background-color: var(--card-bg);
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.logo {
    font-size: 1.5rem;
    font-weight: bold;
}

.logo span {
    color: var(--primary-color);
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 20px;
}

.nav-links a {
    text-decoration: none;
    color: var(--text-color);
    font-weight: 500;
}

.btn-theme {
    padding: 8px 16px;
    border: none;
    border-radius: 20px;
    background-color: var(--primary-color);
    color: white;
    cursor: pointer;
}

/* Hero Section */
.hero {
    text-align: center;
    padding: 60px 20px;
    background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
    color: white;
}

.hero h1 {
    font-size: 2.2rem;
    margin-bottom: 10px;
}

/* Grid de Artigos */
.container {
    max-width: 1100px;
    margin: 40px auto;
    padding: 0 20px;
}

.container h2 {
    margin-bottom: 20px;
}

.posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
}

.card {
    background-color: var(--card-bg);
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.tag {
    align-self: flex-start;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 0.8rem;
    color: white;
    margin-bottom: 12px;
}

.ambiente { background-color: #10b981; }
.tecnologia { background-color: #8b5cf6; }
.saude { background-color: #f59e0b; }

.card h3 {
    margin-bottom: 10px;
}

.card p {
    font-size: 0.95rem;
    margin-bottom: 20px;
    opacity: 0.85;
}

.btn-read {
    padding: 10px;
    border: none;
    background-color: var(--primary-color);
    color: white;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
}

.btn-read:hover {
    opacity: 0.9;
}

/* Footer */
footer {
    text-align: center;
    padding: 20px;
    margin-top: 40px;
    background-color: var(--card-bg);
    border-top: 1px solid rgba(0,0,0,0.05);
}
